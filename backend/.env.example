# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres connection string (get this from your Neon project dashboard —
# use the pooled connection string for normal app traffic, ends in "-pooler")
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret used to sign JWTs — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin allowed to call this API (see .claude/rules/auth-conventions.md)
CORS_ORIGIN=http://localhost:5173

PORT=4000
